# Lanvex configuration. Copy to .env and fill in. Never commit .env.
# Every variable is prefixed LANVEX_. See docs/configuration.md for the full list.

# --- Required ---------------------------------------------------------------------
# Password for the bundled PostgreSQL (docker-compose.yml builds LANVEX_DATABASE_URL from it).
LANVEX_POSTGRES_PASSWORD=change-me-to-a-long-random-string

# NetBox base URL (no /api suffix) and an API token for a dedicated Lanvex user.
# v2 tokens look like nbt_<key>.<secret>; v1 tokens are 40 hex characters. Both work.
LANVEX_NETBOX_URL=https://netbox.example.net
LANVEX_NETBOX_TOKEN=
LANVEX_NETBOX_VERIFY_TLS=true

# First administrator, created only if Lanvex has no users yet. Remove after first start.
LANVEX_BOOTSTRAP_ADMIN_USERNAME=admin
LANVEX_BOOTSTRAP_ADMIN_PASSWORD=

# Encrypts server credentials (SSH keys, passwords) at rest. Generate with `lanvex generate-secret-key`.
# Losing it makes stored credentials unreadable; during rotation list the old one in _FALLBACKS (JSON list).
LANVEX_SECRET_KEY=
# LANVEX_SECRET_KEY_FALLBACKS=["previous-key"]

# --- Optional ---------------------------------------------------------------------
# Port on this host. Prefix an address to limit it, e.g. 127.0.0.1:8080 behind a reverse proxy here.
# LANVEX_HTTP_PORT=8080
# Subnet of the Docker network (its gateway is the .1 address). Change only if it overlaps your networks.
# LANVEX_DOCKER_SUBNET=172.31.250.0/24
# LANVEX_LOG_LEVEL=INFO
# LANVEX_NETBOX_TIMEOUT_SECONDS=10
# LANVEX_NETBOX_MAX_RETRIES=2
# LANVEX_SESSION_IDLE_MINUTES=60
# LANVEX_SESSION_ABSOLUTE_HOURS=12
# Set to false only if Lanvex is served over plain HTTP on a trusted network.
# LANVEX_COOKIE_SECURE=true
# Proxies whose X-Forwarded-For/-Proto are trusted (client IPs, HTTPS detection), as a JSON list.
# A reverse proxy on this host reaches the container from the Docker gateway, not from 127.0.0.1:
# LANVEX_TRUSTED_PROXIES=["172.31.250.1/32"]

# Server management: only connect to servers inside these networks (JSON list of CIDRs; empty = any).
# LANVEX_SERVER_ALLOWED_NETWORKS=["10.0.0.0/8", "192.168.0.0/16"]
# LANVEX_SSH_CONNECT_TIMEOUT_SECONDS=10
# LANVEX_SSH_COMMAND_TIMEOUT_SECONDS=15
# LANVEX_SERVER_SNAPSHOT_RETENTION=20

# Phase 2 — infrastructure-changing automation. Leave disabled; nothing uses it yet.
LANVEX_AUTOMATION_ENABLED=false
