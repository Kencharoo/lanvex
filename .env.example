# Lanvex configuration. The installer (./install.sh) writes .env for you, with generated passwords
# and keys; this file is for setting it up by hand. Copy to .env and fill in. Never commit .env.
# Every variable is prefixed LANVEX_. See docs/configuration.md for the full list.

# --- Required ---------------------------------------------------------------------
# Password for the bundled PostgreSQL (docker-compose.yml builds LANVEX_DATABASE_URL from it).
LANVEX_POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Where your network is documented. Either your own NetBox (below) or Lanvex Core, the NetBox-based
# application bundled with Lanvex (the "Lanvex Core" section further down instead of these lines).
# NetBox base URL (no /api suffix) and an API token for a dedicated Lanvex user.
# v2 tokens look like nbt_<key>.<secret>; v1 tokens are 40 hex characters. Both work.
LANVEX_NETBOX_URL=https://netbox.example.net
LANVEX_NETBOX_TOKEN=
LANVEX_NETBOX_VERIFY_TLS=true

# First administrator, created only if Lanvex has no users yet. Remove after first start.
LANVEX_BOOTSTRAP_ADMIN_USERNAME=admin
LANVEX_BOOTSTRAP_ADMIN_PASSWORD=

# Encrypts server credentials (SSH keys, passwords) at rest. Generate with `lanvex generate-secret-key`.
# Losing it makes stored credentials unreadable; during rotation list the old one in _FALLBACKS (JSON list).
LANVEX_SECRET_KEY=
# LANVEX_SECRET_KEY_FALLBACKS=["previous-key"]

# --- Optional ---------------------------------------------------------------------
# Port on this host. Prefix an address to limit it, e.g. 127.0.0.1:8080 behind a reverse proxy here.
# LANVEX_HTTP_PORT=8080
# Subnet of the Docker network (its gateway is the .1 address). Change only if it overlaps your networks.
# LANVEX_DOCKER_SUBNET=172.31.250.0/24
# LANVEX_LOG_LEVEL=INFO
# LANVEX_NETBOX_TIMEOUT_SECONDS=10
# LANVEX_NETBOX_MAX_RETRIES=2
# LANVEX_SESSION_IDLE_MINUTES=60
# LANVEX_SESSION_ABSOLUTE_HOURS=12
# Set to false only if Lanvex is served over plain HTTP on a trusted network.
# LANVEX_COOKIE_SECURE=true
# Proxies whose X-Forwarded-For/-Proto are trusted (client IPs, HTTPS detection), as a JSON list.
# A reverse proxy on this host reaches the container from the Docker gateway, not from 127.0.0.1:
# LANVEX_TRUSTED_PROXIES=["172.31.250.1/32"]

# Server management: only connect to servers inside these networks (JSON list of CIDRs; empty = any).
# LANVEX_SERVER_ALLOWED_NETWORKS=["10.0.0.0/8", "192.168.0.0/16"]
# LANVEX_SSH_CONNECT_TIMEOUT_SECONDS=10
# LANVEX_SSH_COMMAND_TIMEOUT_SECONDS=15
# LANVEX_SERVER_SNAPSHOT_RETENTION=200

# Switches, read over SNMP (docs/switches.md). Every 15 minutes unless a switch sets its own; 0 = never.
# LANVEX_SWITCH_READ_INTERVAL_MINUTES=15
# LANVEX_SNMP_TIMEOUT_SECONDS=2
# LANVEX_SNMP_RETRIES=1

# --- Monitoring and alerts (docs/monitoring.md) -----------------------------------
# Where browsers reach Lanvex, for links in alert messages.
# LANVEX_PUBLIC_URL=https://lanvex.example.net
# How often each server's SSH port is checked (seconds); LANVEX_MONITOR_ENABLED=false turns monitoring off.
# LANVEX_MONITOR_PROBE_SECONDS=120
# Email for alerts; recipients are set in Lanvex (Settings, Monitoring). Security: starttls, tls or none.
# LANVEX_SMTP_HOST=mail.example.net
# LANVEX_SMTP_PORT=587
# LANVEX_SMTP_SECURITY=starttls
# LANVEX_SMTP_USERNAME=lanvex@example.net
# LANVEX_SMTP_PASSWORD=
# LANVEX_SMTP_FROM=Lanvex <lanvex@example.net>

# --- Sign-in with a directory or single sign-on (docs/sign-in.md) -------------------
# Active Directory or LDAP: people sign in with their account; the groups decide the role.
# LANVEX_LDAP_URL=ldaps://dc1.example.net ldaps://dc2.example.net
# LANVEX_LDAP_TYPE=ad
# LANVEX_LDAP_BIND_DN=CN=svc-lanvex,OU=Service Accounts,DC=example,DC=net
# LANVEX_LDAP_BIND_PASSWORD=
# LANVEX_LDAP_USER_BASE=OU=Staff,DC=example,DC=net
# LANVEX_LDAP_ADMIN_GROUP=CN=Lanvex Admins,OU=Groups,DC=example,DC=net
# LANVEX_LDAP_READONLY_GROUP=CN=IT Staff,OU=Groups,DC=example,DC=net
# OpenID Connect (Keycloak, Entra ID, Authentik, …); needs LANVEX_PUBLIC_URL. Redirect URI:
# <LANVEX_PUBLIC_URL>/api/v1/auth/sso/callback
# LANVEX_OIDC_ISSUER=https://sso.example.net/realms/example
# LANVEX_OIDC_CLIENT_ID=lanvex
# LANVEX_OIDC_CLIENT_SECRET=
# LANVEX_OIDC_ADMIN_GROUPS=["net-admins"]
# LANVEX_OIDC_READONLY_GROUPS=["it-staff"]
# LANVEX_OIDC_NAME=Company account

# Changing server configuration through Lanvex (previewed, approved, verified, rolled back on
# failure). Off until you need it; docs/changes.md explains what turning it on allows.
LANVEX_AUTOMATION_ENABLED=false

# --- Lanvex Core (optional) -------------------------------------------------------
# Runs Lanvex Core next to Lanvex and serves it at /core/, signed in through Lanvex. Needs the
# Lanvex Core source in ./core (release archives include it; in a git checkout: scripts/fetch-core.sh).
# Generate each secret with: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 64; echo
# The service token is nbt_ + 12 letters/digits + . + 40 letters/digits; use it in both places.
# docs/core.md explains every line.
# COMPOSE_PROFILES=core
# LANVEX_NETBOX_URL=http://core:8080/core
# LANVEX_NETBOX_TOKEN=nbt_xxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANVEX_NETBOX_PUBLIC_URL=/core
# LANVEX_CORE_UPSTREAM_URL=http://core:8080
# LANVEX_CORE_STATIC_DIR=/srv/core-static
# LANVEX_CORE_PROXY_SECRET=
# LANVEX_CORE_SERVICE_TOKEN=nbt_xxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANVEX_CORE_DB_PASSWORD=
# LANVEX_CORE_SECRET_KEY=
# LANVEX_CORE_API_TOKEN_PEPPER=
# LANVEX_CORE_TIME_ZONE=Europe/Berlin
